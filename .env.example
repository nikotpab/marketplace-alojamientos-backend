# Copiar a .env (no se versiona). Lo leen Spring Boot y docker compose.
DB_URL=jdbc:postgresql://localhost:5432/marketplace?currentSchema=marketplace
DB_USUARIO_MIGRACION=marketplace_owner
DB_CONTRASENA_MIGRACION=cambiar
DB_USUARIO_APP=marketplace_app
DB_CONTRASENA_APP=cambiar
# Mínimo 32 caracteres. Para un valor seguro: openssl rand -hex 32
JWT_SECRETO=cambiar-cambiar-cambiar-cambiar-cambiar
# simulado | stripe
PAGOS_PROVEEDOR=simulado
STRIPE_CLAVE_SECRETA=
# Método de pago de prueba. pm_card_chargeDeclined simula un rechazo.
STRIPE_METODO_PAGO=pm_card_visa
