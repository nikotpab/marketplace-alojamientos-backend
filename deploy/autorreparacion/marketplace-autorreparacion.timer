# SCRUM-122: con el healthcheck de la imagen (cada 30 s, 3 fallos), una API colgada se reinicia en menos de 3 min.
[Unit]
Description=Revisa cada minuto si algún contenedor del marketplace quedó unhealthy

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
