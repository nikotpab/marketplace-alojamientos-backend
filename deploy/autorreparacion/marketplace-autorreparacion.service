# SCRUM-122: reinicia los contenedores del marketplace que quedaron unhealthy. Lo lanza el timer del mismo nombre.
[Unit]
Description=Reinicia los contenedores unhealthy del marketplace
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/bin/sh /opt/marketplace/autorreparacion/reiniciar-colgados.sh
