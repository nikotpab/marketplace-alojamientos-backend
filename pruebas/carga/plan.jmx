        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Fechas distintas para cada reserva">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">props.putIfAbsent('reservas', new java.util.concurrent.atomic.AtomicInteger())
int n = props.get('reservas').incrementAndGet()
def llegada = java.time.LocalDate.now().plusDays(30 + n * 3)
vars.put('llegada', llegada.toString())
vars.put('salida', llegada.plusDays(2).toString())</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="confirmacion">
          <stringProp name="HTTPSampler.path">/api/v1/reservas</stringProp>
